{
// =========================================================================
  // 1. PHP INTELEPHENSE (Moteur d'autocomplétion PHP 8.4 + WordPress)
  // =========================================================================
  "intelephense.environment.phpVersion": "8.4.0",
  "intelephense.stubs": [
    "apache", "bcmath", "bz2", "calendar", "com_dotnet", "Core", "ctype",
    "curl", "date", "dba", "dom", "enchant", "exif", "FFI", "fileinfo",
    "filter", "fpm", "ftp", "gd", "gettext", "gmp", "hash", "iconv", "imap",
    "intl", "json", "ldap", "libxml", "mbstring", "meta", "mysqli", "oci8",
    "odbc", "openssl", "pcntl", "pcre", "PDO", "pgsql", "Phar", "posix",
    "pspell", "random", "readline", "Reflection", "session", "shmop",
    "SimpleXML", "snmp", "soap", "sockets", "sodium", "SPL", "sqlite3",
    "standard", "superglobals", "sysvmsg", "sysvsem", "sysvshm", "tidy",
    "tokenizer", "xml", "xmlreader", "xmlrpc", "xmlwriter", "xsl",
    "Zend OPcache", "zip", "zlib",
    "wordpress"
  ],
  // Évite qu'Intelephense indexe en double les stubs déjà téléchargés pour PHPStan
  "intelephense.files.exclude": [
    "**/.git/**",
    "**/.svn/**",
    "**/.hg/**",
    "**/CVS/**",
    "**/.DS_Store/**",
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**/{Tests,tests}/**",
    "**/.history/**",
    "**/vendor/**/vendor/**",
    "**/vendor/php-stubs/wordpress-stubs/**"
  ],
  "intelephense.format.enable": false,
  
  // =========================================================================
  // 2. PHPCS & PHPCBF (via l'extension valeryanm.vscode-phpsab)
  // =========================================================================
  "phpsab.executablePathCS": "${workspaceFolder}/vendor/bin/phpcs",
  "phpsab.executablePathCBF": "${workspaceFolder}/vendor/bin/phpcbf",
  "phpsab.standard": "${workspaceFolder}/phpcs.xml",
  "phpsab.snifferShowSources": true,
  "[php]": {
    "editor.defaultFormatter": "valeryanm.vscode-phpsab",
    "editor.formatOnSave": true
  },

  // =========================================================================
  // 3. PHPSTAN (Analyse Level 8 en temps réel)
  // =========================================================================
  "phpstan.enabled": true,
  "phpstan.binPath": "${workspaceFolder}/vendor/bin/phpstan",
  "phpstan.configFile": "${workspaceFolder}/phpstan.neon",
  "phpstan.memoryLimit": "2G",

  // =========================================================================
  // 4. ESLINT 9 (Flat Config : eslint.config.js pour JS / TS)
  // =========================================================================
  "eslint.useFlatConfig": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },

  // =========================================================================
  // 5. EXCLUSIONS DE RECHERCHE & FICHIERS CACHES
  // =========================================================================
  "files.exclude": {
    "**/.phpunit.cache": true,
    "**/.phpcs.cache": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/vendor": true,
    "**/build": true,
    "**/dist": true,
    "**/.phpunit.cache": true,
    "**/.phpcs.cache": true
  }
}
